{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deltahub.invalid/ai-review/v0.1/history-import-output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1.0"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_unit_id": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/agent_finding"
            }
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "source_unit_id",
          "findings",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/limitation"
      }
    },
    "omission_resolutions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/import_resolution"
      }
    }
  },
  "required": [
    "schema_version",
    "entries",
    "limitations",
    "omission_resolutions"
  ],
  "additionalProperties": false
}
