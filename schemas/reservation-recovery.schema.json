{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deltahub.invalid/ai-review/v0.1/reservation-recovery.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "review_id": {
      "type": "string"
    },
    "claim": {
      "$ref": "common.schema.json#/$defs/reservation_recovery_claim"
    },
    "abandoned_reservation": {
      "$ref": "common.schema.json#/$defs/report_reservation"
    },
    "status": {
      "enum": [
        "claimed",
        "reconciled",
        "finalized"
      ]
    },
    "publication_checkpoint": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_report": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_completed_report": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "claim",
    "abandoned_reservation",
    "status",
    "publication_checkpoint",
    "terminal_report",
    "last_completed_report",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "finalized"
          }
        }
      },
      "then": {
        "properties": {
          "terminal_report": {
            "type": "object"
          },
          "publication_checkpoint": {
            "type": "object"
          }
        }
      }
    }
  ]
}
