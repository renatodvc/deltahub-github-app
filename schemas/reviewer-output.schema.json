{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deltahub.invalid/ai-review/v0.1/reviewer-output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/agent_finding"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/limitation"
      }
    },
    "quality_control": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/quality_control"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "summary",
    "findings",
    "limitations",
    "quality_control"
  ],
  "additionalProperties": false
}
