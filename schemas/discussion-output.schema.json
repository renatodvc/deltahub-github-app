{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deltahub.invalid/ai-review/v0.1/discussion-output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/limitation"
      }
    },
    "proposed_reassessments": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/proposed_reassessment"
      }
    },
    "closed_finding_decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/closure_review_decision"
      }
    }
  },
  "required": [
    "schema_version",
    "limitations",
    "proposed_reassessments",
    "closed_finding_decisions"
  ],
  "additionalProperties": false
}
