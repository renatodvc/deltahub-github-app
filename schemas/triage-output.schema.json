{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deltahub.invalid/ai-review/v0.1/triage-output.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.1.0"
      ],
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "$ref": "common.schema.json#/$defs/model"
          },
          "owns_quality_control": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "mandatory_lens_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "perspectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "model",
          "owns_quality_control",
          "scope",
          "instructions",
          "rationale",
          "mandatory_lens_ids",
          "perspectives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "rationale",
    "assignments"
  ],
  "additionalProperties": false
}
